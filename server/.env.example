# server config — copy to .env and adjust

# http port for the api
PORT=4000

# secret used to sign login tokens — change this in production
JWT_SECRET=change-me-to-a-long-random-string

# database — sqlite file by default, works with zero setup.
# for postgres use something like:
# DATABASE_URL="postgresql://user:password@localhost:5432/fokus"
DATABASE_URL="file:./dev.db"

# ai provider: offline | openai | huggingface
# offline  = built-in template generator, no key needed (default)
# openai   = any openai-compatible chat api
# huggingface = hf inference router (also openai-compatible)
AI_PROVIDER=offline

# keys + endpoints for the real providers
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# huggingface example:
# AI_PROVIDER=huggingface
# AI_API_KEY=hf_xxxx
# AI_BASE_URL=https://router.huggingface.co/v1
# AI_MODEL=meta-llama/Llama-3.1-8B-Instruct
